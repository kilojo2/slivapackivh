# ============================================================
# SlivaPack — environment variables (EXAMPLE ONLY)
# Скопируйте в .env и заполните реальными значениями.
# НИКОГДА не коммитьте реальный .env в git.
# ============================================================

# --- Telegram Bot ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Секрет для верификации webhook (случайная строка, задаётся при установке webhook)
TELEGRAM_WEBHOOK_SECRET=
# Белый список chat_id, которым разрешено публиковать (через запятую)
TELEGRAM_ALLOWED_CHAT_IDS=
# Адрес Telegram Bot API: https://api.telegram.org или http://localhost:8081 (локальный сервер)
TELEGRAM_API_ROOT=https://api.telegram.org
# URL webhook (для локального сервера в том же контейнере: http://localhost:3001/api/telegram/webhook)
TELEGRAM_WEBHOOK_URL=
# api_id/api_hash для локального Telegram Bot API Server (получить на my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- База данных ---
DATABASE_URL=

# --- S3-совместимое хранилище ---
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=
S3_PUBLIC_URL=

# --- Frontend ---
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_MEDIA_URL=

# --- Backend ---
PORT=3001
CORS_ORIGIN=http://localhost:3000

# --- Общее ---
NODE_ENV=development
